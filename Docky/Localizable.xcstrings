    "Allows tiles to use the enlarged dock sizing behavior when enabled.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que los íconos usen el comportamiento de tamaño ampliado del dock cuando está activado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，图块可使用放大的 Dock 尺寸行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，圖塊可使用放大的 Dock 尺寸行為。"
          }
        },
        "zh-HK": {
