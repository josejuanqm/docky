    "Scales custom divider images. Has no effect on the default line.": {
      "comment": "Passed as a String parameter (sliderRow/contentInsetRow/enum title), not auto-extracted by Xcode.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放自定义分隔线图像。对默认线条无效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮放自定義分隔線影象。對預設線條無效。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "縮放自定義分隔線圖像。對默認線條無效。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met à l'échelle les images personnalisées des séparateurs. Sans effet sur la ligne par défaut."
          }
        }
      }
