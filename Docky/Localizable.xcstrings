        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未获准使用Finder自动化"
          }
        }
      }
    },
    "Allow Docky to control Finder in Privacy & Security > Automation, or use the Automation (Finder) row in Docky Settings to request access again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
