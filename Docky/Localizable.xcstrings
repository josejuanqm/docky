          }
        }
      }
    },
    "Shows running apps from an app folder immediately to the right of that folder, and lets the folder reflect how many grouped apps are open.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las apps en ejecución de una carpeta de apps justo a la derecha de esa carpeta y permite que la carpeta refleje cuántas apps agrupadas están abiertas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用文件夹紧右侧的区域内显示该文件夹中正在运行的应用，并让文件夹反映已打开的分组应用数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在應用資料夾緊右側的區域內顯示該資料夾中正在執行的應用，並讓資料夾反映已開啟的分組應用數量。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在應用文件夾緊右側的區域內顯示該文件夾中正在運行的應用，並讓文件夾反映已打開的分組應用數量。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les applications en cours d'un dossier d'applications juste à droite de ce dossier, et fait refléter au dossier le nombre d'applications groupées ouvertes."
          }
        }
      }
    },
    "Shows the current date and month at a glance.": {
      "localizations": {
        "es": {
          "stringUnit": {
