    "Horizontal gap between icons at the reference height. Lower values pack icons tighter, higher values spread them out.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考高度下图标之间的水平间距。数值越小，图标排列越紧凑；数值越大，图标间距越大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考高度下圖示之間的水平間距。數值越小，圖示排列越緊湊；數值越大，圖示間距越大。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "參考高度下圖標之間的水平間距。數值越小，圖標排列越緊湊；數值越大，圖標間距越大。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace horizontal entre les icônes à la hauteur de référence. Les valeurs basses resserrent les icônes, les valeurs hautes les écartent."
