    },
    "%lld%%" : {
      "comment" : "A text label showing the current padding",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%%"
          }
        }
      }
