    "Next" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下一步"
          }
        }
      }
    },
    "%@ is required" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要%@权限"
          }
        }
      }
    },
    "Allow Docky in Privacy & Security so it can perform %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“隐私与安全性”中允许 Docky，以便执行%@。"
          }
        }
      }
    },
    "Security" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全性"
          }
        }
      }
    },
    "Allow installing widgets from links" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许通过链接安装小组件"
          }
        }
      }
    },
    "Links like `docky://install-widget` let a web page install a widget. Off by default. Widgets are native plugins that run inside Docky with the same access Docky has — Accessibility, Automation, files, and more — and Docky doesn't sandbox or verify them, so only install widgets you trust. Installing a `.dockywidget` file yourself always works." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`docky://install-widget` 等链接可让网页安装小组件，此功能默认关闭。小组件是原生插件，在 Docky 内运行，拥有与 Docky 相同的访问权限，包括辅助功能、自动化和文件访问等。Docky 不会将小组件隔离在沙盒中，也不会验证小组件，因此请仅安装你信任的小组件。你始终可以手动安装 `.dockywidget` 文件。"
          }
        }
      }
    },
    "Animation Duration" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动画时长"
          }
        }
      }
    },
    "How long the slide takes when Docky shows or hides its window. Set to 0 to snap instantly." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 Docky 显示或隐藏窗口时的滑动动画时长。设为 0 即可立即显示或隐藏。"
          }
        }
      }
    },
    "Dim Idle App Icons" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调暗空闲应用图标"
          }
        }
      }
    },
    "Fades an app's tile to half opacity while the app is hidden or has no windows open. Turn off to keep icons fully opaque regardless of state. Detecting open windows needs Accessibility permission." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当应用已隐藏或没有打开的窗口时，将其图标项的不透明度降至一半。关闭后，图标在任何状态下都保持完全不透明。检测打开的窗口需要辅助功能权限。"
          }
        }
      }
    },
    "Temperature" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温度"
          }
        }
      }
