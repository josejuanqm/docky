    "Maximum icon edge on a 1440p screen. Smaller displays scale down from this value; larger ones are clamped to it. Default is 128 pt.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1440p 屏幕上的图标最大边长。较小的显示屏按此值等比缩小，较大的则以此为上限。默认值为 128 磅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1440p 螢幕上的圖示最大邊長。較小的顯示屏按此值等比縮小，較大的則以此為上限。預設值為 128 磅。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "1440p 屏幕上的圖標最大邊長。較小的顯示屏按此值等比縮小，較大的則以此為上限。默認值為 128 磅。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille maximale d'un bord d'icône sur un écran 1440p. Les petits écrans sont réduits à partir de cette valeur ; les plus grands y sont limités. La valeur par défaut est de 128 pt."
          }
        }
      }
    },
