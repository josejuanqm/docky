    "Removes the main window's glossy gradient border and Liquid Glass material while keeping the existing blur and background tinting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el borde brillante con degradado y el material de Liquid Glass de la ventana principal, manteniendo el desenfoque y el tinte de fondo existentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除主窗口的亮泽渐变边框和液态玻璃材质，同时保留现有的模糊和背景着色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除主視窗的亮澤漸變邊框和液態玻璃材質，同時保留現有的模糊和背景著色。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "移除主窗口的亮澤漸變邊框和液態玻璃材質，同時保留現有的模糊和背景着色。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le bord en dégradé lumineux et le matériau Liquid Glass de la fenêtre principale tout en conservant le flou et la teinte de fond existants."
          }
        }
      }
    },
