    "Focus each selected window immediately while keeping the original cycling order frozen until you release the shortcut.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfoca cada ventana seleccionada de inmediato manteniendo congelado el orden de ciclado original hasta que sueltes el atajo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即聚焦每个选中的窗口，同时保持原有的循环顺序锁定，直到你松开快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即聚焦每個選中的視窗，同時保持原有的迴圈順序鎖定，直到你鬆開快捷鍵。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "立即聚焦每個選中的窗口，同時保持原有的循環順序鎖定，直到你鬆開快捷鍵。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne immédiatement le focus à chaque fenêtre sélectionnée en conservant l'ordre de défilement d'origine figé jusqu'à la libération du raccourci."
          }
        }
      }
    },
