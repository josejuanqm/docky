    "Padding between the dock panel and the chrome view, per edge. Full-axis mode forces these to 0 regardless.": {
      "comment": "A description of the content inset rows in the appearance settings view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 面板与外框视图之间按边设置的内边距。全部轴模式会无视此设置并强制将其归零。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 面板與外框檢視之間按邊設定的內邊距。全部軸模式會無視此設定並強制將其歸零。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 面板與外框視圖之間按邊設置的內邊距。全部軸模式會無視此設置並強制將其歸零。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marge entre le panneau du dock et la vue du cadre, par bord. Le mode axe complet les force à 0, quel que soit le réglage."
          }
        }
      }
    },
    "Paged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
