    "This permission is already enabled. You can continue when ready." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此权限已启用。准备好后即可继续。"
          }
        }
      }
    },
    "macOS has this disabled right now. Open System Settings, enable it, then come back and re-check." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 当前已停用此权限。请打开系统设置，启用后返回并重新检查。"
          }
        }
      }
    },
    "Docky will guide you through the fastest way to enable this on your Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docky 将引导你以最快的方式在 Mac 上启用此权限。"
