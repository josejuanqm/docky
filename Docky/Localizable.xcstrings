        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住某个选项可在切换器后方预览该窗口，并且在你松开快捷键之前不会改变焦点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住某個選項可在切換器後方預覽該視窗，並且在你鬆開快捷鍵之前不會改變焦點。"
          }
        },
        "zh-HK": {
