    "Describe the issue, idea, or feedback. The diagnostic bundle below is attached automatically so the maintainer can replicate your setup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请描述问题、想法或反馈。下面的诊断包会自动附加，便于维护者复现你的配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請描述問題、想法或反饋。下面的診斷包會自動附加，便於維護者復現你的配置。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請描述問題、想法或反饋。下面的診斷包會自動附加，便於維護者復現你的配置。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez le problème, l'idée ou le retour. Le bundle de diagnostic ci-dessous est joint automatiquement afin que le mainteneur puisse reproduire votre configuration."
          }
        }
      }
    },
