    },
    "Paints the red notification count (like Mail's unread total) on running app tiles. Read from the system Dock, so it needs Accessibility permission.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在运行中的应用图块上绘制红色通知计数（例如邮件的未读总数）。数据读取自系统 Dock，因此需要辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在執行中的應用圖塊上繪製紅色通知計數（例如郵件的未讀總數）。資料讀取自系統 Dock，因此需要輔助功能許可權。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在運行中的應用圖塊上繪製紅色通知計數（例如郵件的未讀總數）。數據讀取自系統 Dock，因此需要輔助功能權限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le compteur de notifications rouge (comme le total de non-lus de Mail) sur les tuiles des applications en cours. Lu depuis le Dock du système, donc nécessite l'autorisation Accessibilité."
          }
        }
      }
    },
