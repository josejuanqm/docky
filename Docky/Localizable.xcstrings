    "Controls how long Docky waits after the pointer leaves and interactions end before the window hides.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla cuánto espera Docky después de que el puntero sale y terminan las interacciones antes de ocultar la ventana."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制指针移开、交互结束后，Docky 等待多久才隐藏窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制指標移開、互動結束後，Docky 等待多久才隱藏視窗。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "控制指針移開、交互結束後，Docky 等待多久才隱藏窗口。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle le délai d'attente de Docky après la sortie du pointeur et la fin des interactions avant le masquage de la fenêtre."
          }
        }
      }
    },
    "Controls how much each divider is inset along its short axis, as a fraction of the tile size.": {
      "comment": "Passed as a String parameter (sliderRow/contentInsetRow/enum title), not auto-extracted by Xcode.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制分隔线沿短轴的内缩量，以图块尺寸的比例表示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制分隔線沿短軸的內縮量，以圖塊尺寸的比例表示。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "控制分隔線沿短軸的內縮量，以圖塊尺寸的比例表示。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle l'enfoncement de chaque séparateur selon son axe court, en fraction de la taille de la tuile."
          }
        }
      }
    },
    "Controls how strongly the tint color is laid over the window blur.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla con qué intensidad se aplica el color de tinte sobre el desenfoque de la ventana."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制着色叠加在窗口模糊效果上的强度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制著色疊加在視窗模糊效果上的強度。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "控制着色疊加在窗口模糊效果上的強度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle l'intensité avec laquelle la teinte est superposée au flou de la fenêtre."
          }
        }
      }
    },
    "Controls how visible dividers are. 100% is fully opaque; 0% hides them entirely.": {
      "comment": "Passed as a String parameter (sliderRow/contentInsetRow/enum title), not auto-extracted by Xcode.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制分隔线的可见度。100% 为完全不透明；0% 则完全隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制分隔線的可見度。100% 為完全不透明；0% 則完全隱藏。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "控制分隔線的可見度。100% 為完全不透明；0% 則完全隱藏。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle l'opacité des séparateurs. 100 % est totalement opaque ; 0 % les masque complètement."
          }
        }
      }
    },
    "Controls the base width and height of each dock tile.": {
