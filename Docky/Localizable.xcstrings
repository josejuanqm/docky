    },
    "Choose a custom image for any app Docky currently knows about. Custom app icons follow Docky's circle tile clipping when circle tiles are enabled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una imagen personalizada para cualquier app que Docky conozca actualmente. Los íconos personalizados siguen el recorte circular de Docky cuando se activan los íconos circulares."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Docky 已知的任意应用选择自定义图像。启用圆形图块后，自定义应用图标会按 Docky 的圆形裁切方式显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 Docky 已知的任意應用選擇自定義影象。啟用圓形圖塊後，自定義應用圖示會按 Docky 的圓形裁切方式顯示。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "為 Docky 已知的任意應用選擇自定義圖像。啓用圓形圖塊後，自定義應用圖標會按 Docky 的圓形裁切方式顯示。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une image personnalisée pour toute application que Docky connaît actuellement. Les icônes d'applications personnalisées suivent le découpage circulaire de Docky lorsque les tuiles circulaires sont activées."
          }
        }
      }
    },
    "Choose a name for this app folder.": {
      "localizations": {
        "zh-Hans": {
