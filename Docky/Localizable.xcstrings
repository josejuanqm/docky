    "Docky can periodically check getdocky.com for new signed releases. Sparkle stores these update preferences directly in your user defaults.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky puede consultar periódicamente getdocky.com en busca de nuevas versiones firmadas. Sparkle guarda estas preferencias de actualización directamente en tus user defaults."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky 可定期检查 getdocky.com 是否有已签名的新版本。Sparkle 会把这些更新偏好设置直接存储在你的用户默认设置中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky 可定期檢查 getdocky.com 是否有已簽名的新版本。Sparkle 會把這些更新偏好設定直接儲存在你的使用者預設設定中。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky 可定期檢查 getdocky.com 是否有已簽名的新版本。Sparkle 會把這些更新偏好設置直接存儲在你的用户默認設置中。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky peut vérifier périodiquement getdocky.com à la recherche de nouvelles versions signées. Sparkle enregistre ces préférences de mise à jour directement dans vos réglages utilisateur."
          }
        }
      }
    },
