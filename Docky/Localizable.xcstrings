    "Override the chrome outline with a solid color. When off, Docky uses its default glass stroke (or no stroke when Glass is disabled).": {
      "comment": "A description of the \"Use Custom Border\" toggle.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用纯色覆盖外框轮廓。关闭时，Docky 会使用默认的玻璃描边（如果关闭“玻璃”则不使用描边）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用純色覆蓋外框輪廓。關閉時，Docky 會使用預設的玻璃描邊（如果關閉“玻璃”則不使用描邊）。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用純色覆蓋外框輪廓。關閉時，Docky 會使用默認的玻璃描邊（如果關閉“玻璃”則不使用描邊）。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace le contour du cadre par une couleur pleine. Lorsqu'il est désactivé, Docky utilise son contour de verre par défaut (aucun contour lorsque Verre est désactivé)."
          }
        }
      }
    },
    "Override the translucent tint behind the main dock window. Leave this off to keep following the system material color.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescribe el tinte translúcido detrás de la ventana principal del dock. Déjalo desactivado para seguir el color del material del sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖主 Dock 窗口背后的半透明色调。保持关闭以继续跟随系统材质颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覆蓋主 Dock 視窗背後的半透明色調。保持關閉以繼續跟隨系統材質顏色。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "覆蓋主 Dock 窗口背後的半透明色調。保持關閉以繼續跟隨系統材質顏色。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace la teinte translucide derrière la fenêtre de dock principale. Laissez ceci désactivé pour conserver la couleur de matériau système."
          }
        }
      }
    },
