          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche vos propres photos, en les faisant défiler comme un diaporama."
          }
        }
      }
    },
    "Shrinks the rendered icon inside each tile without changing the tile's layout box. Useful for Windows-style chunky tile slots.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不改变图标布局框的前提下，缩小每个图标内渲染的图标。适用于 Windows 风格的粗块图标槽位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在不改變圖示佈局框的前提下，縮小每個圖示內渲染的圖示。適用於 Windows 風格的粗塊圖示槽位。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在不改變圖標佈局框的前提下，縮小每個圖標內渲染的圖標。適用於 Windows 風格的粗塊圖標槽位。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétrécit l'icône rendue à l'intérieur de chaque tuile sans modifier sa boîte de mise en page. Utile pour les cases de tuile épaisses au style Windows."
          }
        }
      }
    },
    "Shut Down...": {
      "comment": "Rendered through a String-based path; not auto-extracted by Xcode.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关机…"
          }
        },
        "zh-Hant": {
