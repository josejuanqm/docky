    "Leave this unset if you only want to open Launchpad from the Docky tile or context menu.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo sin asignar si solo quieres abrir Launchpad desde el ícono o menú contextual de Docky."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你只想从 Docky 的图块或右键菜单中打开启动台，请保持此选项未设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你只想從 Docky 的圖塊或右鍵選單中開啟啟動臺，請保持此選項未設定。"
          }
        },
        "zh-HK": {
