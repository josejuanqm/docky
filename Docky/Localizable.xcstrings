          "stringUnit": {
            "state": "translated",
            "value": "Docky n'a pas pu préparer l'AppleScript nécessaire à cette action Finder."
          }
        }
      }
    },
    "Docky couldn't prepare the AppleScript needed to request System Events automation.": {
      "comment": "Rendered through a String-based path; not auto-extracted by Xcode.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
