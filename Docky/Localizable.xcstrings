    "Docky uses a single main window. Choose whether it stays on the primary display or follows the display containing the pointer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky utiliza una sola ventana principal. Elige si permanece en la pantalla principal o si sigue a la pantalla donde se encuentra el puntero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky 使用单个主窗口。选择它固定在主显示器上，还是跟随指针所在的显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky 使用單個主視窗。選擇它固定在主顯示器上，還是跟隨指標所在的顯示器。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky 使用單個主窗口。選擇它固定在主顯示器上，還是跟隨指針所在的顯示器。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docky utilise une seule fenêtre principale. Choisissez si elle reste sur l'écran principal ou suit l'écran contenant le pointeur."
          }
        }
      }
    },
    "Docky wants to control Finder": {
      "comment": "Rendered through a String-based path; not auto-extracted by Xcode.",
      "localizations": {
        "zh-Hans": {
